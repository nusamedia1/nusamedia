---
// src/pages/index.astro
export const prerender = false; // SSR Aktif murni agar berita & iklan selalu up-to-date!

import { supabase } from '../lib/supabase';
import '../styles/global.css';

// 1. AMBIL DATA DARI SUPABASE SECARA PARALEL
const [resBerita, resPopuler, resIklan] = await Promise.all([
  supabase
    .from('berita')
    .select('*')
    .order('created_at', { ascending: false }),
  supabase
    .from('berita')
    .select('*')
    .order('views', { ascending: false })
    .limit(5),
  supabase
    .from('iklan')
    .select('*')
    .eq('is_aktif', true)
]);

const dataBeritaMentah = resBerita.data || [];
const errorBerita = resBerita.error;
const beritaPopuler = resPopuler.data || [];
const daftarIklan = resIklan.data || [];

// 2. FILTER DATA IKLAN BANNER UTAMA
const iklanAtas = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_atas');
const iklanBawah = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_bawah');


// ==========================================
// 🔥 STRATEGI PENYELAMATAN: RAKIT SEMUA HTML DI SINI (FRONTMATTER)
// ==========================================

// A. RAKIT HTML DAFTAR BERITA UTAMA
let htmlListBerita = '';
if (errorBerita || dataBeritaMentah.length === 0) {
  htmlListBerita = `<div class="bg-white p-8 rounded-xl text-center text-gray-500 border">Belum ada berita yang diterbitkan.</div>`;
} else {
  htmlListBerita = `<div class="grid grid-cols-1 md:grid-cols-2 gap-6">`;
  dataBeritaMentah.forEach((berita) => {
    const teksMentah = berita.ringkasan || berita.isi_konten || '';
    const ringkasanBersih = teksMentah.replace(/<[^>]*>/g, ''); 
    const tanggal = berita.created_at ? new Date(berita.created_at).toLocaleDateString('id-ID', { dateStyle: 'short' }) : '';
    const gambar = berita.gambar_url || "https://unsplash.com";
    const kategori = berita.kategori || 'Fokus';
    const views = berita.views || 0;
    const penulis = berita.penulis || 'Redaksi';

    htmlListBerita += `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col hover:shadow-md transition">
        <div class="h-48 bg-slate-200 overflow-hidden">
          <img src="${gambar}" alt="${berita.judul}" class="w-full h-full object-cover hover:scale-105 transition duration-300" />
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-black uppercase text-red-600 tracking-wider">${kategori}</span>
              <span class="text-[11px] text-gray-400 flex items-center gap-0.5">👁️ ${views}</span>
            </div>
            <a href="/berita/${berita.id}" class="block text-base font-bold text-slate-900 hover:text-red-600 leading-snug mb-2 transition">
              ${berita.judul}
            </a>
            <p class="text-xs text-gray-500 line-clamp-3 mb-4">
              ${ringkasanBersih}
            </p>
          </div>
          <div class="text-[11px] text-gray-400 border-t pt-2 flex justify-between items-center">
            <span>Oleh: ${penulis}</span>
            <span>${tanggal}</span>
          </div>
        </div>
      </div>
    `;
  });
  htmlListBerita += `</div>`;
}

// B. RAKIT HTML WIDGET BERITA POPULER
let htmlBeritaPopuler = '';
beritaPopuler.forEach((pop, index) => {
  htmlBeritaPopuler += `
    <a href="/berita/${pop.id}" class="flex items-start gap-3 group border-b border-gray-100 pb-2 last:border-0 last:pb-0">
      <span class="text-lg font-black text-gray-300 group-hover:text-red-600 transition min-w-[20px]">0${index + 1}</span>
      <div>
        <h4 class="text-xs font-bold text-slate-800 group-hover:text-blue-600 transition line-clamp-2 leading-tight mb-1">${pop.judul}</h4>
        <span class="text-[10px] text-gray-400">👁️ ${pop.views || 0} pembaca</span>
      </div>
    </a>
  `;
});

// C. RAKIT HTML 5 SUSUN IKLAN SIDEBAR
let htmlSidebarIklan = '';
const listSidebar = ['sidebar_1', 'sidebar_2', 'sidebar_3', 'sidebar_4', 'sidebar_5'];
listSidebar.forEach((posisiNama, indeks) => {
  const ad = daftarIklan.find(a => a.zona_penempatan === 'sidebar' && a.posisi === posisiNama);
  const isSticky = posisiNama === 'sidebar_5' ? 'sticky top-20' : '';

  if (ad) {
    const kontenIklan = ad.tipe === 'script' 
      ? `<div>${ad.kode_html}</div>` 
      : `<a href="${ad.url_tujuan}" target="_blank" rel="noopener noreferrer"><img src="${ad.url_gambar}" class="w-full object-cover rounded-lg shadow-sm" /></a>`;

    htmlSidebarIklan += `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center ${isSticky}">
        <span class="text-[9px] font-bold text-gray-400 block mb-2">SPONSORED BY: ${ad.nama_sponsor} (${indeks + 1}/5)</span>
        ${kontenIklan}
      </div>
    `;
  } else {
    htmlSidebarIklan += `
      <div class="w-full h-48 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4 ${isSticky}">
        <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
        <span class="text-[10px] text-gray-400 mt-1">Slot Sidebar ${indeks + 1}/5</span>
        <a href="mailto:nusamediaterpercaya@gmail.com" class="text-[10px] text-blue-600 font-medium mt-3 hover:underline break-all px-2">
          Hubungi Redaksi
        </a>
      </div>
    `;
  }
});
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nusa-Media | Portal Berita Terpercaya & Aktual</title>
    <meta name="description" content="Nusa-Media menyajikan berita terkini, viral, politik, gaya hidup, dan informasi teknologi terupdate secara real-time." />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com" rel="stylesheet">
    
    <script src="https://tailwindcss.com"></script>
    <style>body { font-family: 'Roboto', sans-serif; }</style>
  </head>
  <body class="bg-gray-100 text-gray-900 min-h-screen antialiased">

    <!-- HEADER / LOGO NAVBAR -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="text-2xl font-black text-red-600 tracking-tighter">NUSA-MEDIA</a>
        <div class="text-xs text-gray-400 hidden sm:block">Kontak Redaksi: <span class="text-blue-600 font-medium">nusamediaterpercaya@gmail.com</span></div>
      </div>
    </header>

    <!-- WRAPPER GRID UTAMA -->
    <main class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- SISI KIRI: DAFTAR BERITA UTAMA -->
      <section class="lg:col-span-8 space-y-6">
        
        <!-- 🔥 IKLAN BANNER ATAS BERANDA -->
        {iklanAtas ? (
          <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center">
            <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {iklanAtas.nama_sponsor}</span>
            {iklanAtas.tipe === 'script' ? <div set:html={iklanAtas.kode_html} /> : <a href={iklanAtas.url_tujuan} target="_blank" rel="noopener noreferrer"><img src={iklanAtas.url_gambar} class="w-full h-auto object-cover rounded-md" /></a>}
          </div>
        ) : (
          <div class="w-full h-32 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4">
            <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
            <span class="text-[10px] text-gray-400 mt-1">Banner Atas (300 x 250)</span>
          </div>
        )}

        <!-- 📰 DAFTAR LIST BERITA -->
        <div set:html={htmlListBerita} />

        <!-- 🔥 IKLAN BANNER BAWAH BERANDA -->
        {iklanBawah ? (
          <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center">
            <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {iklanBawah.nama_sponsor}</span>
            {iklanBawah.tipe === 'script' ? <div set:html={iklanBawah.kode_html} /> : <a href={iklanBawah.url_tujuan} target="_blank" rel="noopener noreferrer"><img src={iklanBawah.url_gambar} class="w-full h-auto object-cover rounded-md" /></a>}
          </div>
        ) : (
          <div class="w-full h-32 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4">
            <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
            <span class="text-[10px] text-gray-400 mt-1">Banner Bawah</span>
          </div>
        )}
      </section>

      <!-- SISI KANAN: SIDEBAR WIDGET & 5 SUSUN IKLAN -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- WIDGET BERITA POPULER -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 space-y-4">
          <h3 class="text-xs font-black uppercase text-slate-900 tracking-wider border-b pb-2 flex items-center justify-between">
            <span>🔥 Paling Populer</span>
            <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
          </h3>
          <div class="space-y-3" set:html={htmlBeritaPopuler} />
        </div>

        <!-- 5 SLOT IKLAN SIDEBAR OTOMATIS -->
        <div class="space-y-4" set:html={htmlSidebarIklan} />

      </aside>
    </main>

    <footer class="bg-slate-900 text-white text-xs py-6 mt-12 border-t border-slate-800 text-center">
