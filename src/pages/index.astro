---
// src/pages/index.astro
export const prerender = false; // SSR Aktif murni!

import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import '../styles/global.css';

// 1. AMBIL DATA DARI SUPABASE SECARA PARALEL
const [resBerita, resPopuler, resIklan] = await Promise.all([
  supabase
    .from('berita')
    .select('*')
    .order('created_at', { ascending: false }),
  supabase
    .from('berita')
    .select('*')
    .order('views', { ascending: false })
    .limit(5),
  supabase
    .from('iklan')
    .select('*')
    .eq('is_aktif', true)
]);

const dataBeritaMentah = resBerita.data || [];
const errorBerita = resBerita.error;
const beritaPopuler = resPopuler.data || [];
const daftarIklan = resIklan.data || [];

// 2. FILTER DATA IKLAN BANNER UTAMA
const iklanAtas = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_atas');
const iklanBawah = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_bawah');

// ==========================================
// 🔥 STRATEGI RAKIT HTML DI FRONTMATTER
// ==========================================

// A. RAKIT HTML DAFTAR BERITA
let htmlListBerita = '';
if (errorBerita || dataBeritaMentah.length === 0) {
  htmlListBerita = `<div class="bg-white p-8 rounded-xl text-center text-gray-500 border border-gray-200">Belum ada berita yang diterbitkan.</div>`;
} else {
  htmlListBerita = `<div class="grid grid-cols-1 md:grid-cols-2 gap-6">`;
  
  dataBeritaMentah.forEach((berita) => {
    const linkDetail = `/berita/${berita.slug || berita.id}`;
    const slugValid = berita.slug || berita.id; 
    const teksMentah = berita.ringkasan || berita.isi_konten || '';
    const ringkasanBersih = teksMentah.replace(/<[^>]*>/g, '').substring(0, 150) + '...'; 
    const tanggal = berita.created_at ? new Date(berita.created_at).toLocaleDateString('id-ID', { dateStyle: 'short' }) : '';
    const gambar = berita.gambar_url || "https://unsplash.com";
    const kategori = berita.kategori || 'Fokus';
    const views = berita.views || 0;
    const penulis = berita.penulis || 'Redaksi';
    
    htmlListBerita += `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col hover:shadow-md transition">
        <div class="h-48 bg-slate-200 overflow-hidden">
          <a href="${linkDetail}">
            <img src="${gambar}" alt="${berita.judul}" class="w-full h-full object-cover hover:scale-105 transition duration-300" loading="lazy" />
          </a>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div class="link-berita cursor-pointer" data-slug="${slugValid}">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10px] font-black uppercase text-red-600 tracking-wider">${kategori}</span>
                <span class="text-[11px] text-gray-400 flex items-center gap-0.5">👁️ ${views}</span>
            </div>
            <a href="${linkDetail}" class="block text-base font-bold text-slate-900 hover:text-red-600 leading-snug mb-2 transition">
              ${berita.judul}
            </a>
            <p class="text-xs text-gray-500 line-clamp-3 mb-4">
              ${ringkasanBersih}
            </p>
          </div>
          <div class="text-[11px] text-gray-400 border-t pt-2 flex justify-between items-center">
            <span>Oleh: ${penulis}</span>
            <span>${tanggal}</span>
          </div>
        </div>
      </div>
    `;
  });

  htmlListBerita += `</div>`;
}

// B. RAKIT HTML WIDGET BERITA POPULER
let htmlBeritaPopuler = '';
if (beritaPopuler.length === 0) {
  htmlBeritaPopuler = `<p class="text-xs text-gray-400">Belum ada berita populer.</p>`;
} else {
  beritaPopuler.forEach((pop, index) => {
    const linkPopuler = `/berita/${pop.slug || pop.id}`;
    htmlBeritaPopuler += `
      <a href="${linkPopuler}" class="flex items-center gap-3 group border-b border-gray-100 pb-3 last:border-0 last:pb-0 pt-2 first:pt-0">
        <span class="text-2xl font-black text-gray-200 group-hover:text-red-600 transition min-w-[30px] text-center">0${index + 1}</span>
        <div class="flex-1">
          <h4 class="text-sm font-semibold text-slate-800 group-hover:text-red-600 transition line-clamp-2 leading-snug mb-1">${pop.judul}</h4>
          <span class="text-[11px] text-gray-400 flex items-center gap-1">👁️ ${pop.views || 0} pembaca</span>
        </div>
      </a>
    `;
  });
}

// C. RAKIT HTML 5 SUSUN IKLAN SIDEBAR
let htmlSidebarIklan = ''; 
const listSidebar = ['sidebar_1', 'sidebar_2', 'sidebar_3', 'sidebar_4', 'sidebar_5'];

listSidebar.forEach((posisiNama, indeks) => {
  const ad = daftarIklan.find(a => a.zona_penempatan === 'sidebar' && a.posisi === posisiNama);

  if (ad) {
    const kontenIklan = ad.tipe === 'script' 
      ? `<div class="w-full overflow-hidden flex items-center justify-center">${ad.kode_html}</div>` 
      : `<a href="${ad.url_tujuan}" target="_blank" rel="noopener noreferrer" class="block w-full overflow-hidden rounded-lg"><img src="${ad.url_gambar}" class="w-full h-auto object-cover mx-auto" /></a>`;

    htmlSidebarIklan += `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center flex flex-col justify-between hover:shadow-md transition">
        <span class="text-[9px] font-bold text-gray-400 block mb-2 uppercase tracking-tight">SPONSORED BY: ${ad.nama_sponsor}</span>
        ${kontenIklan}
      </div>
    `;
  } else {
    htmlSidebarIklan += `
      <div class="w-full bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-6">
        <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
        <span class="text-[10px] text-gray-400 mt-1">Slot Sidebar ${indeks + 1}/5</span>
        <a href="mailto:nusamediaterpercaya@gmail.com" class="text-[10px] text-blue-600 font-medium mt-3 hover:underline break-all">
          Hubungi Redaksi
        </a>
      </div>
    `;
  }
});

htmlSidebarIklan += `</div>`;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="monetag" content="e2d28fc31d665936f12fb3b18580ad5e">
    <meta name="google-site-verification" content="l5OUrKYhXd2xSJoOiUK7_SgioLghRAJtkMeem4d4yzA" />
    <meta name="google-adsense-account" content="ca-pub-9117310114118325">
    <title>Nusa-Media | Portal Berita Terpercaya & Aktual</title>
    <meta name="description" content="Nusa-Media menyajikan berita terkini, viral, politik, gaya lifestyle, dan informasi teknologi terupdate secara real-time." />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <style>body { font-family: 'Roboto', sans-serif; }</style>
  </head>
    <body class="bg-gray-50 text-gray-900 min-h-screen antialiased flex flex-col">

    <!-- NAVBAR -->
    <header class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div>
          <a href="/" class="text-2xl font-black tracking-tight text-red-600 block leading-none">
            NUSA<span class="text-slate-800"> MEDIA</span>
          </a>
          <span class="text-[10px] font-bold text-gray-400 tracking-widest uppercase block mt-1">
            Media Berita Terpercaya
          </span>
        </div>
        <div class="text-xs text-gray-500 font-medium">
          Kontak Redaksi: <a href="mailto:nusamediaterpercaya@gmail.com" class="text-blue-600 hover:underline">nusamediaterpercaya@gmail.com</a>
        </div>
      </div>
    </header>

   <!-- KONTEN UTAMA DENGAN STRUKTUR GRID PROFESIONAL -->
    <main class="max-w-7xl w-full mx-auto px-4 py-6 flex-1">
      
      <!-- Grid Induk Utama (Otomatis membagi kolom untuk HP, Tablet, Laptop) -->
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-12 gap-6 items-start">
        
               <!-- KOLOM 1: DAFTAR FEED BERITA & BANNER UTAMA (KIRI) -->
        <section class="md:col-span-2 lg:col-span-6 space-y-6">
          <h2 class="text-lg font-bold text-slate-900 border-l-4 border-red-600 pl-2 uppercase tracking-wide">
            Berita Terbaru
          </h2>

          <!-- 🔥 IKLAN BANNER ATAS ARTIKEL -->
          {iklanAtas ? (
            <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center">
              <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {iklanAtas.nama_sponsor}</span>
              {iklanAtas.tipe === 'script' ? (
                <>
                  <div set:html={iklanAtas.kode_html} />
                  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                </>
              ) : (
                <a href={iklanAtas.url_tujuan} target="_blank" rel="noopener noreferrer" class="w-full">
                  <img src={iklanAtas.url_gambar} class="w-full h-auto object-cover rounded-md" />
                </a>
              )}
            </div>
          ) : (
            <div class="w-full h-32 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4">
              <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
              <span class="text-[10px] text-gray-400 mt-1">Banner Atas</span>
            </div>
          )}

          <!-- 🔥 PERBAIKAN: Daftar Berita Ter-render Menggunakan Fragment -->
          <Fragment set:html={htmlListBerita} />

          <!-- 🔥 IKLAN BANNER BAWAH ARTIKEL -->
          {iklanBawah ? (
            <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center mt-6">
              <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {iklanBawah.nama_sponsor}</span>
              {iklanBawah.tipe === 'script' ? (
                <>
                  <div set:html={iklanBawah.kode_html} />
                  <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                </>
              ) : (
                <a href={iklanBawah.url_tujuan} target="_blank" rel="noopener noreferrer" class="w-full">
                  <img src={iklanBawah.url_gambar} class="w-full h-auto object-cover rounded-md" />
                </a>
              )}
            </div>
          ) : (
            <div class="w-full h-32 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4 mt-6">
              <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
              <span class="text-[10px] text-gray-400 mt-1">Banner Bawah</span>
            </div>
          )}
        </section>

            <!-- KOLOM 2: WIDGET TERPOPULER -->
        <aside class="md:col-span-1 lg:col-span-3 flex flex-col gap-4 sticky md:top-20">
          <h2 class="text-lg font-bold text-slate-900 border-l-4 border-slate-800 pl-2 uppercase tracking-wide">
            Terpopuler
          </h2>
          <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex flex-col gap-3">
            <Fragment set:html={htmlBeritaPopuler} />
          </div>
        </aside>

<!-- KOLOM 3: SPONSOR / IKLAN SIDEBAR -->
        <aside class="md:col-span-3 lg:col-span-3 flex flex-col gap-4 lg:sticky lg:top-20">
          <h2 class="text-lg font-bold text-slate-900 border-l-4 border-amber-500 pl-2 uppercase tracking-wide">
            Kemitraan
          </h2>
          <!-- Di tablet otomatis membagi 2 kolom bersisian, di laptop kembali tegak lurus -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-1 gap-4 w-full">
            <Fragment set:html={htmlSidebarIklan} />
          </div>
        </aside>

  </div> <!-- Penutup DIV Grid Utama -->
</main> <!-- Penutup MAIN Luar -->

<!-- FOOTER FORMAL -->
<footer class="bg-slate-900 text-gray-400 text-center py-6 mt-12 border-t border-slate-800 text-xs">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-center items-center gap-4 mb-3">
      <a href="mailto:nusamediaterpercaya@gmail.com" class="text-gray-500 hover:text-red-600 transition">
        Kontak Redaksi
      </a>
    </div>
    <p>&copy; {new Date().getFullYear()} NUSA MEDIA. All Rights Reserved.</p>
  </div>
</footer>

</body>
</html>

