---
// src/pages/index.astro
export const prerender = false; // 🚀 SSR Aktif murni agar berita & iklan selalu up-to-date!

import { supabase } from '../lib/supabase';
import '../styles/global.css';

// OPTIMASI: Paralelisasi Query menggunakan Promise.all
const [resBerita, resPopuler, resIklan] = await Promise.all([
  supabase
    .from('berita')
    .select('*')
    .order('created_at', { ascending: false }),
  supabase
    .from('berita')
    .select('*')
    .order('views', { ascending: false })
    .limit(5),
  supabase
    .from('iklan')
    .select('*')
    .eq('is_aktif', true)
]);

const listBerita = resBerita.data;
const errorBerita = resBerita.error;
const beritaPopuler = resPopuler.data;
const daftarIklan = resIklan.data;

// Fungsi pembantu penyaring ganda: Wajib COCOK antara ZONA dan POSISI
const dapatkanIklan = (zonaNama: string, posisiNama: string) => {
  return daftarIklan?.find(
    ad => ad.zona_penempatan === zonaNama && ad.posisi === posisiNama
  );
};
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nusa-Media | Portal Berita Terpercaya & Aktual</title>
    <meta name="description" content="Nusa-Media menyajikan berita terkini, viral, politik, gaya hidup, dan informasi teknologi terupdate secara real-time." />
    
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Roboto:wght=400;500;700;900&display=swap" rel="stylesheet">
    
    <script src="https://tailwindcss.com"></script>
    <style>body { font-family: 'Roboto', sans-serif; }</style>
  </head>
  <body class="bg-gray-100 text-gray-900 min-h-screen antialiased">

    <!-- HEADER / LOGO NAVBAR -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="text-2xl font-black text-red-600 tracking-tighter">NUSA-MEDIA</a>
        <div class="text-xs text-gray-400 hidden sm:block">Kontak Redaksi: <span class="text-blue-600 font-medium">nusamediaterpercaya@gmail.com</span></div>
      </div>
    </header>

    <!-- WRAPPER GRID UTAMA -->
    <main class="max-w-6xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- SISI KIRI: DAFTAR BERITA UTAMA (8 Kolom) -->
      <section class="lg:col-span-8 space-y-6">
        
        <!-- 🔥 IKLAN BANNER ATAS BERANDA -->
        {(() => {
          const ad = dapatkanIklan('artikel', 'banner_atas');
          return ad ? (
            <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center">
              <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {ad.nama_sponsor}</span>
              {ad.tipe === 'script' ? <div set:html={ad.kode_html} /> : <a href={ad.url_tujuan} target="_blank" rel="noopener noreferrer"><img src={ad.url_gambar} class="w-[300px] h-[250px] object-cover rounded-md" /></a>}
            </div>
          ) : (
            /* Kotak Kosong Banner Atas dengan Tautan Email Resmi */
            <div class="w-full max-w-[300px] h-[250px] mx-auto bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4">
              <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
              <span class="text-[10px] text-gray-400 mt-1">Banner Atas (300 x 250)</span>
              <a href="mailto:nusamediaterpercaya@://gmail.com" class="text-[11px] text-blue-600 font-medium mt-3 hover:underline">
                Hubungi: nusamediaterpercaya@gmail.com
              </a>
            </div>
          );
        })()}

        <h2 class="text-xl font-black text-slate-900 uppercase border-b-2 border-red-600 pb-1 inline-block tracking-wide">
          Berita Terbaru
        </h2>

        {errorBerita || !listBerita || listBerita.length === 0 ? (
          <div class="bg-white p-8 rounded-xl text-center text-gray-500 border">Belum ada berita yang diterbitkan.</div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {listBerita.map((berita) => (
              <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col hover:shadow-md transition">
                <div class="h-48 bg-slate-200 overflow-hidden">
                  <img src={berita.gambar_url || "https://unsplash.com"} alt={berita.judul} class="w-full h-full object-cover hover:scale-105 transition duration-300" />
                </div>
                <div class="p-4 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="text-[10px] font-black uppercase text-red-600 tracking-wider">{berita.kategori || 'Fokus'}</span>
                      <span class="text-[11px] text-gray-400 flex items-center gap-0.5">👁️ {berita.views || 0}</span>
                    </div>
                    <a href={`/berita/${berita.id}`} class="block text-base font-bold text-slate-900 hover:text-red-600 leading-snug mb-2 transition">
                      {berita.judul}
                    </a>
                    <p class="text-xs text-gray-500 line-clamp-3 mb-4">
                      {(berita.ringkasan || berita.isi_konten || '').replace(/<[^>]*>/g, '')}
                    </p>
                  </div>
                  <div class="text-[11px] text-gray-400 border-t pt-2 flex justify-between items-center">
                    <span>Oleh: {berita.penulis || 'Redaksi'}</span>
                    <span>{berita.created_at ? new Date(berita.created_at).toLocaleDateString('id-ID', { dateStyle: 'short' }) : ''}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- 🔥 IKLAN BANNER BAWAH BERANDA -->
        {(() => {
          const ad = dapatkanIklan('artikel', 'banner_bawah');
          return ad ? (
            <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center mt-6">
              <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {ad.nama_sponsor}</span>
              {ad.tipe === 'script' ? <div set:html={ad.kode_html} /> : <a href={ad.url_tujuan} target="_blank" rel="noopener noreferrer"><img src={ad.url_gambar} class="w-[300px] h-[250px] object-cover rounded-md" /></a>}
            </div>
          ) : (
            /* Kotak Kosong Banner Bawah dengan Tautan Email Resmi */
            <div class="w-full max-w-[300px] h-[250px] mx-auto bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4 mt-6">
              <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
              <span class="text-[10px] text-gray-400 mt-1">Banner Bawah (300 x 250)</span>
              <a href="mailto:nusamediaterpercaya@://gmail.com" class="text-[11px] text-blue-600 font-medium mt-3 hover:underline">
                Hubungi: nusamediaterpercaya@gmail.com
              </a>
            </div>
          );
        })()}

      </section>

      <!-- SISI KANAN: SIDEBAR IKLAN 5 SUSUN & BERITA POPULER (4 Kolom) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        
        <!-- WIDGET BERITA POPULER -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
          <h3 class="text-sm font-black text-slate-900 uppercase border-b-2 border-red-600 pb-1 mb-4 tracking-wide">
            Berita Populer
          </h3>
          <div class="space-y-3">
            {beritaPopuler?.map((pop, index) => (
              <a href={`/berita/${pop.id}`} class="flex items-start gap-3 group border-b border-gray-100 pb-2 last:border-0 last:pb-0">
                <span class="text-lg font-black text-gray-300 group-hover:text-red-600 transition min-w-[20px]">0{index + 1}</span>
                <div>
                  <h4 class="text-xs font-bold text-slate-800 group-hover:text-blue-600 transition line-clamp-2 leading-tight mb-1">{pop.judul}</h4>
                  <span class="text-[10px] text-gray-400">👁️ {pop.views || 0} pembaca</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- 5 SUSUN IKLAN SIDEBAR DINAMIS -->
        {['sidebar_1', 'sidebar_2', 'sidebar_3', 'sidebar_4', 'sidebar_5'].map((posisiNama, indeks) => {
          const ad = dapatkanIklan('sidebar', posisiNama);
          const isSticky = posisiNama === 'sidebar_5' ? 'sticky top-20' : '';
          
          return ad ? (
            <div class={`bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center ${isSticky}`}>
              <span class="text-[9px] font-bold text-gray-400 block mb-2">SPONSORED BY: {ad.nama_sponsor} ({indeks + 1}/5)</span>
              {ad.tipe === 'script' ? (
                <div set:html={ad.kode_html} />
              ) : (
                <a href={ad.url_tujuan} target="_blank" rel="noopener noreferrer">
                  <img src={ad.url_gambar} class="w-full object-cover rounded-lg shadow-sm" />
                </a>
              )}
            </div>
          ) : (
            /* Kotak Kosong Sidebar dengan Tautan Email Resmi Otomatis Berdasarkan Posisi Slot */
            <div class={`w-full h-48 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4 ${isSticky}`}>
// bypass-cache
