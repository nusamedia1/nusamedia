// src/pages/berita/[slug].astro
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase'; 
import '../../styles/global.css';

const { slug } = Astro.params;

// Amankan jika slug kosong
const slugAman = slug || "fitur-berita";

const PROJECT_ID = import.meta.env.SUPABASE_PROJECT_ID || "gnuxrjwiyiikkyjxgzff";
const ANON_KEY = import.meta.env.SUPABASE_ANON_KEY || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdudXhyandpeWlpa2t5anhnemZmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk2MTQyOTQsImV4cCI6MjA5NTE5MDI5NH0.OFjoavfuIebaPiSLSgDyf-rUbfyzfvf9dibRgkmoNDg";
const BASE_URL = `https://${PROJECT_ID}.supabase.co/rest/v1`;

let berita = null;
let beritaPopuler = [];
let daftarIklan = [];

try {
  // Ambil data dengan metode pengaman agar tidak memicu crash keras
  const [resDetail, resPopuler, resIklan] = await Promise.all([
    supabase.from('berita').select('*').eq('slug', slugAman).maybeSingle(),
    supabase.from('berita').select('*').order('views', { ascending: false }).limit(5),
    supabase.from('iklan').select('*').eq('is_aktif', true)
  ]); 

  berita = resDetail?.data || null;
  beritaPopuler = resPopuler?.data || [];
  daftarIklan = resIklan?.data || [];
} catch (e) {
  console.error("Gagal memuat data:", e);
}
if (berita && berita.id) {
  // Ambil nilai views saat ini, jika tidak ada set ke 0, lalu tambah 1
  const viewsSaatIni = berita.views || 0;
  const viewsBaru = viewsSaatIni + 1;

  // Langsung update ke tabel 'berita' berdasarkan ID-nya
  const { error: updateError } = await supabase
    .from('berita')
    .update({ views: viewsBaru })
    .eq('id', berita.id); // Mencocokkan ID artikel

  if (updateError) {
    console.error("🔴 GAGAL UPDATE VIEWS:", updateError.message);
  } else {
    // Update data lokal agar langsung tampil di layar pembaca
    berita.views = viewsBaru;
  }
}
// ─── KONDISI JIKA BERITA KOSONG / BELUM TERSEDIA ───
// Alih-alih melempar redirect, kita siapkan data bayangan agar halaman TIDAK ERROR
if (!berita) {
  berita = {
    judul: "Artikel Belum Tersedia atau Sedang Dalam Peninjauan",
    kategori: "Info",
    penulis: "Redaksi Nusa Media",
    isi_konten: "Mohon maaf, artikel berita dengan alamat tautan tersebut tidak ditemukan atau telah diperbarui oleh redaksi kami. Silakan kembali ke halaman utama untuk membaca berita terhangat lainnya.",
    gambar_url: null,
    created_at: new Date().toISOString()
  };
}

// 3. FILTER DATA IKLAN BANNER UTAMA
const iklanAtas = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_atas');
const iklanBawah = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_bawah');

// ==========================================
// 🔥 STRATEGI RAKIT HTML IKLAN & WIDGET (FRONTMATTER)
// ==========================================

// A. RAKIT HTML WIDGET BERITA POPULER SIDEBAR
let htmlBeritaPopuler = '';
beritaPopuler.forEach((pop, index) => {
  htmlBeritaPopuler += `
    <div class="flex items-start gap-3 group border-b border-gray-100 pb-2 last:border-0 last:pb-0">
      <span class="text-lg font-black text-gray-300 group-hover:text-red-600 transition min-w-[20px]">0${index + 1}</span>
      <div>
        <h4 class="text-xs font-bold text-slate-800 group-hover:text-blue-600 transition line-clamp-2 leading-tight mb-1">
          <a href="/berita/${pop.slug}">${pop.judul}</a>
        </h4>
        <span class="text-[10px] text-gray-400">👁️ ${pop.views || 0} pembaca</span>
        <br/>
        <span class="text-[10px] text-gray-400">Hubungi kami: </span> 
        <a href="mailto:nusamediaterpercaya@gmail.com" class="text-blue-600 text-[10px] hover:underline">nusamediaterpercaya@gmail.com</a>
      </div>
    </div>
  `;
});

// B. RAKIT HTML 5 SUSUN IKLAN SIDEBAR
let htmlSidebarIklan = '';
const listSidebar = ['sidebar_1', 'sidebar_2', 'sidebar_3', 'sidebar_4', 'sidebar_5'];
listSidebar.forEach((posisiNama, indeks) => {
  const ad = daftarIklan.find(a => a.zona_penempatan === 'sidebar' && a.posisi === posisiNama);
  const isSticky = posisiNama === 'sidebar_5' ? 'sticky top-20' : '';

  if (ad) {
    const kontenIklan = ad.tipe === 'script' 
      ? `<div>${ad.kode_html}</div>` 
      : `<a href="${ad.url_tujuan}" target="_blank" rel="noopener noreferrer"><img src="${ad.url_gambar}" class="w-full object-cover rounded-lg shadow-sm" /></a>`;

    htmlSidebarIklan += `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center ${isSticky}">
        <span class="text-[9px] font-bold text-gray-400 block mb-2">SPONSORED BY: ${ad.nama_sponsor} (${indeks + 1}/5)</span>
        ${kontenIklan}
      </div>
    `;
  } else {
    htmlSidebarIklan += `
      <div class="w-full h-48 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4 ${isSticky}">
        <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
        <span class="text-[10px] text-gray-400 mt-1">Slot Sidebar ${indeks + 1}/5</span>
        <a href="mailto:nusamediaterpercaya@gmail.com" class="text-[10px] text-blue-600 font-medium mt-3 hover:underline break-all px-2">
          Hubungi Redaksi
        </a>
      </div>
    `;
  }
});

const tanggalFormat = berita.created_at ? new Date(berita.created_at).toLocaleDateString('id-ID', { dateStyle: 'long' }) : '';

// 🟢 WARNAI/TARUH KODE BARU DI SINI:
const DOMAIN_UTAMA = "https://nusamedia-11t.pages.dev"; 
const urlArtikelPenuh = encodeURIComponent(`${DOMAIN_UTAMA}/berita/${slug}`);
const judulArtikelPenuh = encodeURIComponent(berita.judul);

const linkShareWhatsapp = `https://api.whatsapp.com/send/?text=nusamedia-11t.pages.dev`;
const linkShareFacebook = `https://facebook.com/share/nusamedia-11t.pages.dev`;
const urlAsliUntukSalin = `https://nusamedia-11t.pages.dev/berita/`;
const kontenMentah = berita.isi_konten || berita.konten || "";
const daftarParagraf = kontenMentah
  .split(/\r?\n/)
  .map(p => p.trim())
  .filter(p => p.length > 0);
