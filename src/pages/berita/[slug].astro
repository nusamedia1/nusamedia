---
// src/pages/berita/[slug].astro
export const prerender = false; // Murni Server-Side Rendering (SSR)

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase'; 
import '../../styles/global.css';

const { slug } = Astro.params;
const slugAman = slug || "fitur-berita";

let berita = null;
let beritaPopuler = [];
let daftarIklan = [];

try {
  // Ambil data berita secara aman agar tidak crash jika slug tidak ada
  const [resDetail, resPopuler, resIklan] = await Promise.all([
    supabase.from('berita').select('*').eq('slug', slugAman).maybeSingle(),
    supabase.from('berita').select('*').order('views', { ascending: false }).limit(5),
    supabase.from('iklan').select('*').eq('is_aktif', true)
  ]); 

  berita = resDetail?.data || null;
  beritaPopuler = resPopuler?.data || [];
  daftarIklan = resIklan?.data || [];
} catch (e) {
  console.error("Gagal memuat data dari database:", e);
}

// UPDATE JUMLAH PEMBACA (VIEWS)
if (berita && berita.id) {
  const viewsSaatIni = berita.views || 0;
  const viewsBaru = viewsSaatIni + 1;

  await supabase
    .from('berita')
    .update({ views: viewsBaru })
    .eq('id', berita.id);
    
  berita.views = viewsBaru;
}

// JIKA BERITA KOSONG (SIAPKAN DATA CADANGAN AGAR HALAMAN TIDAK EROR)
if (!berita) {
  berita = {
    judul: "Artikel Belum Tersedia atau Sedang Dalam Peninjauan",
    kategori: "Info",
    penulis: "Redaksi Nusa Media",
    isi_konten: "Mohon maaf, artikel berita dengan alamat tautan tersebut tidak ditemukan atau telah diperbarui oleh redaksi kami.",
    gambar_url: null,
    created_at: new Date().toISOString()
  };
}

// FILTER BANNER IKLAN UTAMA
const iklanAtas = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_atas');
const iklanBawah = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_bawah');

// RAKIT HTML BERITA POPULER SIDEBAR
let htmlBeritaPopuler = '';
beritaPopuler.forEach((pop, index) => {
  htmlBeritaPopuler += `
    <div class="flex items-start gap-3 group border-b border-gray-100 pb-3 last:border-0 last:pb-0 pt-2 first:pt-0">
      <span class="text-2xl font-black text-gray-200 group-hover:text-red-600 transition min-w-[30px] text-center">0${index + 1}</span>
      <div class="flex-1">
        <h4 class="text-sm font-semibold text-slate-800 group-hover:text-red-600 transition line-clamp-2 leading-snug mb-1">
          <a href="/berita/${pop.slug || pop.id}">${pop.judul}</a>
        </h4>
        <span class="text-[11px] text-gray-400">👁️ ${pop.views || 0} pembaca</span>
      </div>
    </div>
  `;
});

// RAKIT HTML 5 SUSUN IKLAN SIDEBAR
let htmlSidebarIklan = '';
const listSidebar = ['sidebar_1', 'sidebar_2', 'sidebar_3', 'sidebar_4', 'sidebar_5'];
listSidebar.forEach((posisiNama) => {
  const ad = daftarIklan.find(a => a.zona_penempatan === 'sidebar' && a.posisi === posisiNama);
  if (ad) {
    const kontenIklan = ad.tipe === 'script' 
      ? `<div class="w-full overflow-hidden flex items-center justify-center">${ad.kode_html}</div>` 
      : `<a href="${ad.url_tujuan}" target="_blank" rel="noopener noreferrer" class="block w-full overflow-hidden rounded-lg shadow-sm"><img src="${ad.url_gambar}" class="w-full h-auto object-cover mx-auto" /></a>`;

    htmlSidebarIklan += `<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center">${kontenIklan}</div>`;
  }
});

const tanggalFormat = berita.created_at ? new Date(berita.created_at).toLocaleDateString('id-ID', { dateStyle: 'long' }) : '';

// PECAH TEKS BERITA MENJADI PARAGRAF & PENGATURAN LINK SOSIAL MEDIA
const DOMAIN_UTAMA = "https://nusamedia-11t.pages.dev"; 
const urlArtikelPenuh = encodeURIComponent(`${DOMAIN_UTAMA}/berita/${slug}`);
const judulArtikelPenuh = encodeURIComponent(berita.judul);

const linkShareWhatsapp = `https://whatsapp.com{judulArtikelPenuh}%20${urlArtikelPenuh}`;
const linkShareFacebook = `https://facebook.com{urlArtikelPenuh}`;
const urlAsliUntukSalin = `${DOMAIN_UTAMA}/berita/${slug}`;

const kontenMentah = berita.isi_konten || berita.konten || "";
const daftarParagraf = kontenMentah
  .split(/\r?\n/)
  .map(p => p.trim())
  .filter(p => p.length > 0);
---

<!-- 🔥 PERBAIKAN: Mengirim data detail artikel ke Layout untuk pratinjau WhatsApp/Facebook -->
<Layout 
  title={`${berita.judul} | Nusa Media`} 
  description={berita.ringkasan || (berita.isi_konten ? berita.isi_konten.replace(/<[^>]*>/g, '').substring(0, 150) + '...' : 'Baca berita selengkapnya di Nusa Media.')}
  image={berita.gambar_url || "https://pages.dev"}
  kategori={berita.kategori || "Fokus"}
>
  <!-- HEADER & NAVBAR (BARU: NAVBAR TIDAK MEMBEKU & IKON PANAH MODERN) -->
  <header class="bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      
      <!-- SISI KIRI: BRANDING UTAMA -->
      <div>
        <a href="/" class="flex flex-col group items-center sm:items-start">
          <span class="text-2xl sm:text-3xl font-black text-red-600 tracking-tighter leading-none">NUSA<span class="text-slate-800"> MEDIA</span></span>
          <span class="text-[10px] font-bold text-gray-400 tracking-widest uppercase block mt-1">Media Berita Terpercaya</span>
        </a>
      </div>

      <!-- SISI KANAN: KONTAK EMAIL & IKON KEMBALI MODERN INTERAKTIF -->
      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-5 text-xs text-gray-500 w-full sm:w-auto justify-center sm:justify-end">
        
        <!-- Kontak Redaksi Aktif Langsung Terhubung ke Email -->
        <div class="flex items-center justify-center bg-gray-50 sm:bg-transparent px-3 py-1.5 sm:p-0 rounded-full border border-gray-100 sm:border-0 w-full sm:w-auto text-center">
          <span class="font-medium mr-1 hidden sm:inline">Kontak Redaksi:</span>
          <a href="mailto:nusamediaterpercaya@://gmail.com" class="hover:text-red-600 transition flex items-center justify-center gap-1.5 text-slate-700 sm:text-gray-500 font-semibold sm:font-normal group/email">
            <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-gray-400 group-hover/email:text-red-600">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span class="underline decoration-gray-300 hover:decoration-red-600">nusamediaterpercaya@gmail.com</span>
          </a>
        </div>

        <span class="text-gray-200 hidden sm:inline">|</span>

        <!-- Tombol Beranda dengan Ikon Vektor Panah Modern -->
        <a href="/" class="inline-flex items-center justify-center gap-2 font-bold text-slate-700 hover:text-blue-600 bg-gray-100 sm:bg-transparent hover:bg-gray-200 sm:hover:bg-transparent w-full sm:w-auto px-4 py-2 sm:p-0 rounded-lg sm:rounded-none transition group/back text-sm sm:text-xs">
          <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transform group-hover/back:-translate-x-1 transition-transform text-gray-400 group-hover:text-blue-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          <span>Beranda</span>
        </a>

      </div>

    </div>
  </header>

  <!-- KONTEN UTAMA -->
  <main class="max-w-7xl w-full mx-auto px-4 py-6 flex-1">
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-12 gap-6 items-start">

      <!-- ARTIKEL UTAMA (KIRI - 8 KOLOM) -->
      <section class="md:col-span-2 lg:col-span-8 space-y-6">
        
                <!-- 🔥 IKLAN BANNER ATAS (PERBAIKAN: PASTI TERBIT GAMBAR / SCRIPT) -->
        {iklanAtas ? (
          <div class="p-3 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center w-full">
            <span class="text-[9px] font-black text-gray-400 block mb-2 uppercase tracking-wider">
              SPONSORED BY: {iklanAtas.nama_sponsor}
            </span>
            
            {iklanAtas.tipe === 'script' ? (
              /* Jalur jika iklan berupa Script Google Adsense / Monetag */
              <div class="w-full overflow-hidden flex justify-center" set:html={iklanAtas.kode_html} />
            ) : (
              /* Jalur jika iklan berupa File Gambar Banner Biasa */
              <a href={iklanAtas.url_tujuan} target="_blank" rel="noopener noreferrer" class="block w-full">
                <img src={iklanAtas.url_gambar} alt={iklanAtas.nama_sponsor} class="w-full h-auto object-contain rounded-lg mx-auto" />
              </a>
            )}
          </div>
        ) : (
          <div class="w-full h-24 bg-gray-50 rounded-xl border border-dashed border-gray-200 flex items-center justify-center text-xs text-gray-400 uppercase font-bold tracking-wider">
            Slot Iklan Atas Tersedia
          </div>
        )}

        <!-- ISI KARTU KONTEN BERITA -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 md:p-6 lg:p-8 w-full">
          <div class="flex flex-wrap items-center gap-2 text-xs mb-4">
            <span class="bg-red-100 text-red-700 font-bold px-2 py-0.5 rounded text-[10px] uppercase">{berita.kategori}</span>
            <span class="text-gray-400">•</span>
            <span class="text-gray-500">{tanggalFormat}</span>
            <span class="text-gray-400">•</span>
            <span class="text-gray-500">Oleh: <strong class="text-gray-700">{berita.penulis}</strong></span>
          </div>

          <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 leading-tight mb-4">{berita.judul}</h1>

          <!-- PANEL TOMBOL BERBAGI -->
          <div class="flex items-center gap-2 pt-3 pb-3 border-b border-t border-gray-100 flex-wrap my-4">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Bagikan:</span>
            <a id="btnShareWhatsapp" href="#" target="_blank" class="bg-emerald-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">WhatsApp</a>
            <a id="btnShareFacebook" href="#" target="_blank" class="bg-blue-600 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">Facebook</a>
            <!-- 🔥 PERBAIKAN: Tombol Sistem HP diubah menjadi label "Bagikan" dengan Ikon Modern -->
<button 
  id="btn-share-native" 
  class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm transition-colors cursor-pointer border-0 lg:hidden" 
  type="button"
  data-judul={berita.judul}
>
  <!-- Ikon Share Vektor Minimalis -->
  <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186.057-.034a2.25 2.25 0 1 0 2.829-3.414m-2.886 3.448L14.78 8.02m-7.508 5.964.057.034a2.25 2.25 0 1 0 2.837 3.418m-2.894-3.452 6.94 4.14" />
  </svg>
  <span>Bagikan</span>
</button>
            <button id="btnSalinTautan" class="bg-gray-700 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm border-0 cursor-pointer"><span id="teksTombolSalin">Salin Tautan</span></button>
          </div>

          <!-- GAMBAR BERITA -->
          {berita.gambar_url && (
            <div class="rounded-xl overflow-hidden mb-6 bg-slate-100 max-h-[450px]">
              <img src={berita.gambar_url} alt={berita.judul} class="w-full h-auto object-cover" />
            </div>
          )}

          <!-- PARAGRAF TEKS BERITA -->
          <div class="text-base sm:text-lg text-gray-800 leading-relaxed text-justify space-y-6 max-w-3xl mx-auto w-full">
            {daftarParagraf.length > 0 ? (
              daftarParagraf.map((paragraf) => <p set:html={paragraf}></p>)
            ) : (
              <div set:html={berita.isi_konten} />
            )}
          </div>
        </div>

               <!-- 🔥 IKLAN BANNER BAWAH (PERBAIKAN: PASTI TERBIT GAMBAR / SCRIPT) -->
        {iklanBawah ? (
          <div class="p-3 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center mt-6 w-full">
            <span class="text-[9px] font-black text-gray-400 block mb-2 uppercase tracking-wider">
              SPONSORED BY: {iklanBawah.nama_sponsor}
            </span>
            
            {iklanBawah.tipe === 'script' ? (
              /* Jalur jika iklan berupa Script Google Adsense / Monetag */
              <div class="w-full overflow-hidden flex justify-center" set:html={iklanBawah.kode_html} />
            ) : (
              /* Jalur jika iklan berupa File Gambar Banner Biasa */
              <a href={iklanBawah.url_tujuan} target="_blank" rel="noopener noreferrer" class="block w-full">
                <img src={iklanBawah.url_gambar} alt={iklanBawah.nama_sponsor} class="w-full h-auto object-contain rounded-lg mx-auto" />
              </a>
            )}
          </div>
        ) : (
          <div class="w-full h-24 bg-gray-50 rounded-xl border border-dashed border-gray-200 flex items-center justify-center text-xs text-gray-400 uppercase font-bold tracking-wider mt-6">
            Slot Iklan Bawah Tersedia
          </div>
        )}
      </section>

            <!-- SIDEBAR (KANAN - 4 KOLOM - FIXED: KOP IKLAN DINAMIS SESUAI DATABASE) -->
      <aside class="md:col-span-1 lg:col-span-4 space-y-6 w-full lg:sticky lg:top-24">
        
        <!-- Box Berita Terpopuler -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 w-full">
          <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b border-gray-100 pb-2 mb-4">🔥 Berita Terpopuler</h3>
          <div class="flex flex-col gap-4 w-full">
            <Fragment set:html={htmlBeritaPopuler} />
          </div>
        </div>

        <!-- Box Susunan Banner Iklan Murni Komponen Astro (Persis Seperti Index) -->
        <div class="space-y-4 w-full">
          {listSidebar.map((posisiNama, indeks) => {
            const ad = daftarIklan.find(a => a.zona_penempatan === 'sidebar' && a.posisi === posisiNama);
            
            return ad ? (
              /* JALUR UTAMA: JIKA IKLAN AKTIF DI DATABASE */
              <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center flex flex-col justify-between hover:shadow-md transition w-full">
                <span class="text-[9px] font-bold text-gray-400 block mb-2 uppercase tracking-tight">
                  SPONSORED BY: {ad.nama_sponsor} ({indeks + 1}/5)
                </span>
                
                {ad.tipe === 'script' ? (
                  <div class="w-full overflow-hidden flex justify-center" set:html={ad.kode_html} />
                ) : (
                  <a href={ad.url_tujuan} target="_blank" rel="noopener noreferrer" class="block w-full">
                    <img src={ad.url_gambar} alt={ad.nama_sponsor} class="w-full h-auto object-contain rounded-lg mx-auto" />
                  </a>
                )}
              </div>
            ) : (
              /* JALUR CADANGAN: JIKA SLOT SIDEBAR DATABASE KOSONG */
              <div class="w-full bg-gray-50 rounded-xl border border-dashed border-gray-200 flex flex-col items-center justify-center text-center p-5">
                <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
                <span class="text-[10px] text-gray-400 mt-1">Slot Sidebar {indeks + 1}/5</span>
                <a href="mailto:nusamediaterpercaya@gmail.com" class="text-[10px] text-blue-600 font-medium mt-3 hover:underline break-all px-2">
                  Hubungi Redaksi
                </a>
              </div>
            );
          })}
        </div>

        <!-- AREA AMP ADSENSE DENGAN PROTEKSI OVERFLOW -->
        <div class="w-full overflow-hidden flex justify-center py-2">
          <amp-ad width="100vw" height="320"
                 type="adsense"
                 data-ad-client="ca-pub-9117310114118325"
                 data-ad-slot="1346127443"
                 data-auto-format="rspv"
                 data-full-width="">
            <div overflow=""></div>
          </amp-ad>
        </div>

      </aside>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-gray-200 mt-12 py-6 text-center text-xs text-gray-400">
    <p>&copy; {new Date().getFullYear()} NUSA MEDIA. All Rights Reserved.</p>
  </footer>
</Layout>

  </body>
</html>

<script is:inline>
  const inisialisasiFiturArtikelNusa = () => {
    const urlBeritaAktif = window.location.href;
    const judulBeritaText = document.querySelector('h1')?.textContent || "NUSA MEDIA";

    // 1. FUNGSI SALIN TAUTAN
    const tombolSalin = document.getElementById('btnSalinTautan');
    const teksTombolSalin = document.getElementById('teksTombolSalin');

    if (tombolSalin && teksTombolSalin) {
      tombolSalin.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(urlBeritaAktif);
          teksTombolSalin.textContent = "✓ Berhasil Disalin!";
          tombolSalin.classList.add('bg-emerald-600');
          
          setTimeout(() => {
            teksTombolSalin.textContent = "Salin Tautan";
            tombolSalin.classList.remove('bg-emerald-600');
          }, 2000);
        } catch (err) {
          console.error('Gagal menyalin:', err);
        }
      });
    }

    // 2. LOGIKA TOMBOL BAGIKAN MEDIA SOSIAL
    const tombolWA = document.getElementById('btnShareWhatsapp');
    if (tombolWA) {
      tombolWA.setAttribute('href', `https://whatsapp.com{encodeURIComponent(judulBeritaText + "\n" + urlBeritaAktif)}`);
    }

    const tombolFB = document.getElementById('btnShareFacebook');
    if (tombolFB) {
      tombolFB.setAttribute('href', `https://facebook.com{encodeURIComponent(urlBeritaAktif)}`);
    }

    // 3. FITUR BAGIKAN BAWAHAN HP (NATIVE)
    const tombolShareNative = document.getElementById('btn-share-native');
    if (tombolShareNative) {
      tombolShareNative.addEventListener('click', async (e) => {
        e.preventDefault();
        if (navigator.share) {
          try {
            await navigator.share({ title: judulBeritaText, url: urlBeritaAktif });
          } catch (err) {
            console.log('Batal berbagi:', err);
          }
        }
      });
    }
  };

  document.addEventListener('astro:page-load', inisialisasiFiturArtikelNusa);
  document.addEventListener('DOMContentLoaded', inisialisasiFiturArtikelNusa);
  inisialisasiFiturArtikelNusa();
</script>

