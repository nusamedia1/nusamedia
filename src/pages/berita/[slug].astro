<script>
  const jalankanSistemBerbagiNusa = () => {
    const urlBeritaAktif = window.location.href;
    const judulBeritaText = document.title;

    // 1. Logika Tombol Salin Tautan
    const tombolSalin = document.getElementById('btnSalinTautan');
    const teksTombolSalin = document.getElementById('teksTombolSalin');

    if (tombolSalin && teksTombolSalin) {
      tombolSalin.addEventListener('click', async () => {
        const linkBerita = tombolSalin.getAttribute('data-url') || urlBeritaAktif;
        try {
          await navigator.clipboard.writeText(linkBerita);
          teksTombolSalin.textContent = "Link Berhasil Disalin! 👍";
          setTimeout(() => {
            teksTombolSalin.textContent = "Salin Tautan";
          }, 2000);
        } catch (err) {
          console.error('Gagal menyalin tautan:', err);
        }
      });
    }

    // 2. Otomatisasi URL Link Tautan WhatsApp & Facebook Desktop
    const tombolWA = document.getElementById('share-wa-nusa');
    if (tombolWA) {
      tombolWA.setAttribute('href', `https://whatsapp.com{encodeURIComponent("Baca berita menarik ini di NUSA MEDIA: " + urlBeritaAktif)}`);
    }

    const tombolFB = document.getElementById('share-fb-nusa');
    if (tombolFB) {
      tombolFB.setAttribute('href', `https://facebook.com{encodeURIComponent(urlBeritaAktif)}`);
    }

    // 3. Fitur Native Share Khusus HP / Smartphone
    const tombolShareNative = document.getElementById('btn-share-native');
    if (tombolShareNative) {
      tombolShareNative.addEventListener('click', async (e) => {
        e.preventDefault();
        const judulBerita = tombolShareNative.getAttribute('data-judul') || judulBeritaText;
        let urlBerita = urlBeritaAktif;

        if (urlBerita.includes('fbclid=')) {
          try {
            const objekURL = new URL(urlBerita);
            objekURL.searchParams.delete('fbclid');
            urlBerita = objekURL.toString();
          } catch (err) {
            console.error(err);
          }
        }

        if (navigator.share) {
          try {
            await navigator.share({
              title: judulBerita,
              text: `${judulBerita}\n\n`,
              url: urlBerita,
            });
          } catch (err) {
            console.log('Batal berbagi:', err);
          }
        } else {
          const linkBackupWA = `https://whatsapp.com{encodeURIComponent(judulBerita + "\n" + urlBerita)}`;
          window.open(linkBackupWA, '_blank', 'noopener,noreferrer');
        }
      });
    }
  };

  // Lifecycle Astro untuk menjamin fungsionalitas skrip berjalan lancar
  document.addEventListener('astro:page-load', jalankanSistemBerbagiNusa);
  jalankanSistemBerbagiNusa();
</script>
