        const judulBerita = tombolShareNative.getAttribute('data-judul') || judulBeritaText;
        let urlBerita = urlBeritaAktif;

        if (urlBerita.includes('fbclid=')) {
          try {
            const objekURL = new URL(urlBerita);
            objekURL.searchParams.delete('fbclid');
            urlBerita = objekURL.toString();
          } catch (err) {
            console.error(err);
          }
        }

        if (navigator.share) {
          try {
            await navigator.share({
              title: judulBerita,
              text: `${judulBerita}\n\n`,
              url: urlBerita,
            });
          } catch (err) {
            console.log('Batal berbagi:', err);
          }
        } else {
          const linkBackupWA = `https://whatsapp.com{encodeURIComponent(judulBerita + "\n" + urlBerita)}`;
          window.open(linkBackupWA, '_blank', 'noopener,noreferrer');
        }
      });
    }
  };

  // Pengaman Lifecycle Astro agar fitur tetap aktif saat ganti halaman
  document.addEventListener('astro:page-load', jalankanSistemBerbagiNusa);
  jalankanSistemBerbagiNusa();
</script>
