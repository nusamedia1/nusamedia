---
// src/pages/berita/[slug].astro
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase'; 
import '../../styles/global.css';

const { slug } = Astro.params;

// Amankan jika slug kosong
const slugAman = slug || "fitur-berita";

const PROJECT_ID = import.meta.env.SUPABASE_PROJECT_ID || "gnuxrjwiyiikkyjxgzff";
const ANON_KEY = import.meta.env.SUPABASE_ANON_KEY || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdudXhyandpeWlpa2t5anhnemZmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk2MTQyOTQsImV4cCI6MjA5NTE5MDI5NH0.OFjoavfuIebaPiSLSgDyf-rUbfyzfvf9dibRgkmoNDg";
const BASE_URL = `https://${PROJECT_ID}.supabase.co/rest/v1`;

let berita = null;
let beritaPopuler = [];
let daftarIklan = [];

try {
  // Ambil data dengan metode pengaman agar tidak memicu crash keras
  const [resDetail, resPopuler, resIklan] = await Promise.all([
    supabase.from('berita').select('*').eq('slug', slugAman).maybeSingle(),
    supabase.from('berita').select('*').order('views', { ascending: false }).limit(5),
    supabase.from('iklan').select('*').eq('is_aktif', true)
  ]); 

  berita = resDetail?.data || null;
  beritaPopuler = resPopuler?.data || [];
  daftarIklan = resIklan?.data || [];
} catch (e) {
  console.error("Gagal memuat data:", e);
}

// ─── KONDISI JIKA BERITA KOSONG / BELUM TERSEDIA ───
// Alih-alih melempar redirect, kita siapkan data bayangan agar halaman TIDAK ERROR
if (!berita) {
  berita = {
    judul: "Artikel Belum Tersedia atau Sedang Dalam Peninjauan",
    kategori: "Info",
    penulis: "Redaksi Nusa Media",
    isi_konten: "Mohon maaf, artikel berita dengan alamat tautan tersebut tidak ditemukan atau telah diperbarui oleh redaksi kami. Silakan kembali ke halaman utama untuk membaca berita terhangat lainnya.",
    gambar_url: null,
    created_at: new Date().toISOString()
  };
}

// 3. FILTER DATA IKLAN BANNER UTAMA
const iklanAtas = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_atas');
const iklanBawah = daftarIklan.find(ad => ad.zona_penempatan === 'artikel' && ad.posisi === 'banner_bawah');

// ==========================================
// 🔥 STRATEGI RAKIT HTML IKLAN & WIDGET (FRONTMATTER)
// ==========================================

// A. RAKIT HTML WIDGET BERITA POPULER SIDEBAR
let htmlBeritaPopuler = '';
beritaPopuler.forEach((pop, index) => {
  htmlBeritaPopuler += `
    <div class="flex items-start gap-3 group border-b border-gray-100 pb-2 last:border-0 last:pb-0">
      <span class="text-lg font-black text-gray-300 group-hover:text-red-600 transition min-w-[20px]">0${index + 1}</span>
      <div>
        <h4 class="text-xs font-bold text-slate-800 group-hover:text-blue-600 transition line-clamp-2 leading-tight mb-1">
          <a href="/berita/${pop.slug}">${pop.judul}</a>
        </h4>
        <span class="text-[10px] text-gray-400">👁️ ${pop.views || 0} pembaca</span>
        <br/>
        <span class="text-[10px] text-gray-400">Hubungi kami: </span> 
        <a href="mailto:nusamediaterpercaya@gmail.com" class="text-blue-600 text-[10px] hover:underline">nusamediaterpercaya@gmail.com</a>
      </div>
    </div>
  `;
});

// B. RAKIT HTML 5 SUSUN IKLAN SIDEBAR
let htmlSidebarIklan = '';
const listSidebar = ['sidebar_1', 'sidebar_2', 'sidebar_3', 'sidebar_4', 'sidebar_5'];
listSidebar.forEach((posisiNama, indeks) => {
  const ad = daftarIklan.find(a => a.zona_penempatan === 'sidebar' && a.posisi === posisiNama);
  const isSticky = posisiNama === 'sidebar_5' ? 'sticky top-20' : '';

  if (ad) {
    const kontenIklan = ad.tipe === 'script' 
      ? `<div>${ad.kode_html}</div>` 
      : `<a href="${ad.url_tujuan}" target="_blank" rel="noopener noreferrer"><img src="${ad.url_gambar}" class="w-full object-cover rounded-lg shadow-sm" /></a>`;

    htmlSidebarIklan += `
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 text-center ${isSticky}">
        <span class="text-[9px] font-bold text-gray-400 block mb-2">SPONSORED BY: ${ad.nama_sponsor} (${indeks + 1}/5)</span>
        ${kontenIklan}
      </div>
    `;
  } else {
    htmlSidebarIklan += `
      <div class="w-full h-48 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4 ${isSticky}">
        <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
        <span class="text-[10px] text-gray-400 mt-1">Slot Sidebar ${indeks + 1}/5</span>
        <a href="mailto:nusamediaterpercaya@gmail.com" class="text-[10px] text-blue-600 font-medium mt-3 hover:underline break-all px-2">
          Hubungi Redaksi
        </a>
      </div>
    `;
  }
});

const tanggalFormat = berita.created_at ? new Date(berita.created_at).toLocaleDateString('id-ID', { dateStyle: 'long' }) : '';

// 🟢 WARNAI/TARUH KODE BARU DI SINI:
const DOMAIN_UTAMA = "https://nusaonline.pages.dev"; 
const urlArtikelPenuh = encodeURIComponent(`${DOMAIN_UTAMA}/berita/${slug}`);
const judulArtikelPenuh = encodeURIComponent(berita.judul);

const linkShareWhatsapp = `https://whatsapp.com{encodeURIComponent(pageTitle + pageUrl)}`;
const linkShareFacebook = https://facebook.com{encodeURIComponent(pageUrl)};
const urlAsliUntukSalin = `Astro.url.href`;
---

<Layout title={`${berita.judul} | Nusa Media`}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- 🔝 BARIS NAVIGASI PALING ATAS -->
    <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6">
      <!-- SISI KIRI: TEKS NUSA MEDIA -->
      <a href="/" class="flex flex-col justify-center group">
          <span class="text-2xl font-black text-red-600 tracking-tighter leading-none">NUSA MEDIA</span>
          <span class="text-xs font-medium text-gray-500 uppercase tracking-widest mt-0.5 group-hover:text-slate-800 transition" style="font-size: 10px;">
            Media Berita Terpercaya
          </span>
        </a>
      
      <!-- SISI KANAN: TOMBOL KEMBALI KE BERANDA -->
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-bold text-red-600 hover:text-red-800 transition-colors group">
        <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 transform group-hover:-translate-x-0.5 transition-transform">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Kembali ke Beranda
      </a>
    </div>

    <!-- STRUKTUR GRID KONTEN UTAMA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- SISI KIRI: ISI BERITA LENGKAP & BANNER IKLAN -->
    <section class="lg:col-span-8 space-y-6">
      
      <!-- 🔥 IKLAN BANNER ATAS ARTIKEL -->
      {iklanAtas ? (
        <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center">
          <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {iklanAtas.nama_sponsor}</span>
          {iklanAtas.tipe === 'script' ? <div set:html={iklanAtas.kode_html} /> : <a href={iklanAtas.url_tujuan} target="_blank" rel="noopener noreferrer"><img src={iklanAtas.url_gambar} class="w-full h-auto object-cover rounded-md" /></a>}
        </div>
      ) : (
        <div class="w-full h-32 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4">
          <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
          <span class="text-[10px] text-gray-400 mt-1">Banner Atas</span>
        </div>
      )}

      <!-- 📰 KONTEN UTAMA BERITA -->
      <article class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8 content-area">
        <div class="flex items-center gap-3 text-xs mb-4">
          <span class="bg-red-100 text-red-700 font-bold px-2 py-0.5 rounded text-[10px] uppercase">{berita.kategori || 'Fokus'}</span>
          <span class="text-gray-400">{tanggalFormat}</span>
          <span class="text-gray-400">•</span>
          <span class="text-gray-400">Oleh: <strong class="text-gray-700">{berita.penulis || 'Redaksi'}</strong></span>
        </div>

        <h1 class="text-2xl md:text-3xl font-black text-slate-900 leading-tight mb-6">{berita.judul}</h1>

        <!-- 📢 BARIS TOMBOL BAGIKAN MEDIA SOSIAL & SALIN TAUTAN (TEMPEL DI SINI) -->
          <div class="flex items-center gap-2.5 pt-3 pb-3 border-b border-t border-gray-100 flex-wrap my-4">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Bagikan:</span>
            
            <!-- WhatsApp -->
            <a href={linkShareWhatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm transition-colors decoration-none">
              WhatsApp
            </a>

            <!-- Facebook -->
            <a href={linkShareFacebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm transition-colors decoration-none">
              Facebook
            </a>

            <!-- Salin Tautan -->
            <button id="btnSalinTautan" data-url={urlAsliUntukSalin} class="inline-flex items-center gap-1.5 bg-gray-700 hover:bg-gray-800 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-sm transition-colors cursor-pointer border-0">
              <span id="teksTombolSalin">Salin Tautan</span>
            </button>
          </div>

        {berita.gambar_url && (
          <div class="rounded-xl overflow-hidden mb-6 bg-slate-100">
            <img src={berita.gambar_url} alt={berita.judul} class="w-full h-auto max-h-[450px] object-cover" />
          </div>
        )}

        <!-- ISI KONTEN BERITA -->
        <div class="prose max-w-none text-slate-800 leading-relaxed text-sm md:text-base space-y-4" set:html={berita.isi_konten || berita.konten} />
      </article>

      <!-- 🔥 IKLAN BANNER BAWAH ARTIKEL -->
      {iklanBawah ? (
        <div class="p-2 bg-white rounded-xl shadow-sm border border-gray-200 text-center flex flex-col items-center justify-center">
          <span class="text-[9px] font-bold text-gray-400 block mb-1">SPONSORED BY: {iklanBawah.nama_sponsor}</span>
          {iklanBawah.tipe === 'script' ? <div set:html={iklanBawah.kode_html} /> : <a href={iklanBawah.url_tujuan} target="_blank" rel="noopener noreferrer"><img src={iklanBawah.url_gambar} class="w-full h-auto object-cover rounded-md" /></a>}
        </div>
      ) : (
        <div class="w-full h-32 bg-gray-50 rounded-xl border border-dashed border-gray-300 flex flex-col items-center justify-center text-center p-4">
          <span class="text-xs font-black text-gray-400 uppercase tracking-wider">Space Iklan Tersedia</span>
          <span class="text-[10px] text-gray-400 mt-1">Banner Bawah</span>
        </div>
      )}
    </section>

      <!-- SISI KANAN: SIDEBAR WIDGET & IKLAN SUSUN -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- WIDGET POPULER -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
          <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider border-b pb-2 mb-3">🔥 Berita Terpopuler</h3>
          <div class="flex flex-col gap-3">
            <div set:html={htmlBeritaPopuler} />
          </div>
        </div>

        <!-- 5 SLOT IKLAN SIDEBAR -->
        <div class="space-y-4">
          <div set:html={htmlSidebarIklan} />
        </div>

      </aside>
      
    </main>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-gray-200 mt-12 py-6 text-center text-xs text-gray-400">
      &copy; {new Date().getFullYear()} NUSA-MEDIA. All Rights Reserved.
    </footer>

  </body>
</html>

<script>
  // Logika clipboard murni berjalan di browser pembaca
  const jalankanCopy = () => {
    const tombol = document.getElementById('copy-btn-nusa');
    const teksTombol = document.getElementById('copy-text-nusa');

    if (tombol && teksTombol) {
      tombol.addEventListener('click', async () => {
        const linkBerita = tombol.getAttribute('data-link') || window.location.href;
        try {
          await navigator.clipboard.writeText(linkBerita);
          teksTombol.textContent = "Link Berhasil Disalin! 👍";
          
          setTimeout(() => {
            teksTombol.textContent = "Salin Link";
          }, 2000);
        } catch (err) {
          console.error('Gagal menyalin tautan:', err);
        }
      });
    }
  };

  // Jalankan fungsi saat halaman dimuat
  jalankanCopy();
</script>

